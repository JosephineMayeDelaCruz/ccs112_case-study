APP_NAME=WalangBrownout
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database ----
# Default: MySQL (matches XAMPP/Laragon setups most students use).
# Swap DB_CONNECTION to sqlite if you'd rather not run a MySQL server —
# see README.md "Using SQLite instead" section.
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---- Sanctum / CORS ----
# The React dev server runs on 5173 by default (Vite).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
